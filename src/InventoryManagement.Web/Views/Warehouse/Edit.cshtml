@model Warehouse
@{ ViewData["Title"] = "Edit Warehouse"; var users = (List<User>)ViewBag.Users; }
<div class="card" style="max-width:600px;"><div class="card-header"><h3>Edit: @Model.Name</h3></div><div class="card-body">
    <form method="post" asp-action="Edit">
        <input type="hidden" name="Id" value="@Model.Id" />
        <div class="form-group"><label>Name *</label><input type="text" name="Name" class="form-control" value="@Model.Name" required /></div>
        <div class="form-group"><label>Address</label><input type="text" name="Address" class="form-control" value="@Model.Address" /></div>
        <div class="form-row">
            <div class="form-group"><label>City</label><input type="text" name="City" class="form-control" value="@Model.City" /></div>
            <div class="form-group"><label>Phone</label><input type="tel" name="Phone" class="form-control" value="@Model.Phone" /></div>
        </div>
        <div class="form-group"><label>Manager</label>
            <select name="ManagerUserId" class="form-control"><option value="">None</option>
                @foreach (var u in users)
                {
                    if (Model.ManagerUserId == u.Id) { <option value="@u.Id" selected>@u.FullName</option> }
                    else { <option value="@u.Id">@u.FullName</option> }
                }
            </select></div>
        <div class="form-check" style="margin-bottom:16px;"><input type="checkbox" name="IsActive" value="true" @(Model.IsActive ? "checked" : "") /><label>Active</label></div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a href="/Warehouse" class="btn btn-secondary" style="margin-left:8px;">Cancel</a>
    </form>
</div></div>
