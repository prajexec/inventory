@model List<ActivityLog>
@{ ViewData["Title"] = "Activity Logs"; }
<div class="card"><div class="card-header"><h3>📝 System Activity Log</h3></div>
<div class="table-container"><table>
    <thead><tr><th>Time</th><th>User</th><th>Action</th><th>Entity</th><th>Details</th></tr></thead>
    <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td>@log.Timestamp.ToString("MMM dd, HH:mm:ss")</td>
                <td>@(log.User?.FullName ?? "System")</td>
                <td><span class="badge badge-primary">@log.Action</span></td>
                <td>@log.EntityType @(log.EntityId.HasValue ? $"#{log.EntityId}" : "")</td>
                <td style="max-width:300px; overflow:hidden; text-overflow:ellipsis;">@(log.Details ?? "—")</td>
            </tr>
        }
    </tbody>
</table></div></div>
