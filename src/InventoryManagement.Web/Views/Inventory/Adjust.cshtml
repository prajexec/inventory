@{ ViewData["Title"] = "Adjust Stock"; var products = (List<Product>)ViewBag.Products; var warehouses = (List<Warehouse>)ViewBag.Warehouses; }

<div class="card" style="max-width:600px;">
    <div class="card-header"><h3>Stock Adjustment</h3></div>
    <div class="card-body">
        @if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }
        <form method="post" asp-action="Adjust">
            <div class="form-group">
                <label>Product *</label>
                <select name="productId" class="form-control" required>
                    <option value="">Select product...</option>
                    @foreach (var p in products) { <option value="@p.Id">@p.Name (@p.SKU)</option> }
                </select>
            </div>
            <div class="form-group">
                <label>Warehouse *</label>
                <select name="warehouseId" class="form-control" required>
                    @foreach (var w in warehouses) { <option value="@w.Id">@w.Name</option> }
                </select>
            </div>
            <div class="form-group">
                <label>Quantity (use negative for reduction) *</label>
                <input type="number" name="quantity" class="form-control" required placeholder="e.g. 50 or -10" />
            </div>
            <div class="form-group">
                <label>Reason *</label>
                <textarea name="reason" class="form-control" required placeholder="Reason for adjustment..."></textarea>
            </div>
            <button type="submit" class="btn btn-warning">Apply Adjustment</button>
            <a href="/Inventory" class="btn btn-secondary" style="margin-left:8px;">Cancel</a>
        </form>
    </div>
</div>
