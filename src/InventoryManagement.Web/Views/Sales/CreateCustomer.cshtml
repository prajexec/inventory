@{ ViewData["Title"] = "Add Customer"; }
<div class="card" style="max-width:600px;"><div class="card-header"><h3>New Customer</h3></div><div class="card-body">
    <form method="post" asp-action="CreateCustomer">
        <div class="form-group"><label>Name *</label><input type="text" name="Name" class="form-control" required /></div>
        <div class="form-row">
            <div class="form-group"><label>Email</label><input type="email" name="Email" class="form-control" /></div>
            <div class="form-group"><label>Phone</label><input type="tel" name="Phone" class="form-control" /></div>
        </div>
        <div class="form-group"><label>Address</label><input type="text" name="Address" class="form-control" /></div>
        <div class="form-group"><label>City</label><input type="text" name="City" class="form-control" /></div>
        <button type="submit" class="btn btn-primary">Create Customer</button>
        <a href="/Sales/Customers" class="btn btn-secondary" style="margin-left:8px;">Cancel</a>
    </form>
</div></div>
