@model List<SalesOrder>
@{ ViewData["Title"] = "Sales Orders"; }
<div style="display:flex; justify-content:space-between; margin-bottom:24px;">
    <div style="display:flex; gap:8px;">
        <a href="/Sales" class="btn @(ViewBag.Status == null ? "btn-primary" : "btn-secondary") btn-sm">All</a>
        <a href="/Sales?status=1" class="btn btn-sm btn-secondary">Confirmed</a>
        <a href="/Sales?status=3" class="btn btn-sm btn-secondary">Completed</a>
        <a href="/Sales?status=4" class="btn btn-sm btn-secondary">Returned</a>
    </div>
    <a href="/Sales/Create" class="btn btn-primary">+ New Sale</a>
</div>
<div class="card"><div class="table-container"><table>
    <thead><tr><th>Order #</th><th>Customer</th><th>Items</th><th>Total</th><th>Status</th><th>Date</th><th>Actions</th></tr></thead>
    <tbody>
        @foreach (var so in Model)
        {
            <tr>
                <td><code style="color:var(--primary-light);">@so.OrderNumber</code></td>
                <td>@(so.Customer?.Name ?? "Walk-in")</td>
                <td>@so.Items.Count</td>
                <td style="font-weight:700;">₹@so.TotalAmount.ToString("N2")</td>
                <td><span class="badge @(so.Status == SalesOrderStatus.Confirmed ? "badge-success" : so.Status == SalesOrderStatus.Returned ? "badge-warning" : "badge-info")">@so.Status</span></td>
                <td>@so.OrderDate.ToString("MMM dd, yyyy")</td>
                <td><a href="/Sales/Details/@so.Id" class="btn btn-secondary btn-sm">View</a></td>
            </tr>
        }
    </tbody>
</table></div></div>
