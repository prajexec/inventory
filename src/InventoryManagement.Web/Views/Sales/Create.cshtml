@{ ViewData["Title"] = "Create Sale"; var customers = (List<Customer>)ViewBag.Customers; var warehouses = (List<Warehouse>)ViewBag.Warehouses; var products = (List<Product>)ViewBag.Products; var taxRate = (decimal)ViewBag.TaxRate; }

<div class="card" style="max-width:900px;">
    <div class="card-header"><h3>New Sales Order</h3></div>
    <div class="card-body">
        @if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }
        <form method="post" asp-action="Create">
            <div class="form-row">
                <div class="form-group"><label>Customer</label>
                    <select name="customerId" class="form-control"><option value="">Walk-in Customer</option>
                        @foreach (var c in customers) { <option value="@c.Id">@c.Name</option> }
                    </select></div>
                <div class="form-group"><label>Warehouse *</label>
                    <select name="warehouseId" class="form-control" required>
                        @foreach (var w in warehouses) { <option value="@w.Id">@w.Name</option> }
                    </select></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Discount %</label><input type="number" name="orderDiscountPct" class="form-control" value="0" step="0.01" /></div>
                <div class="form-group"><label>Tax %</label><input type="number" name="taxPct" class="form-control" value="@taxRate" step="0.01" /></div>
            </div>
            <div class="form-group"><label>Notes</label><textarea name="notes" class="form-control"></textarea></div>
            <hr style="border-color:var(--border-color); margin:20px 0;" />
            <h4 style="margin-bottom:16px;">Order Items</h4>
            <div id="items">
                <div class="form-row" style="margin-bottom:12px;">
                    <div class="form-group" style="flex:2; margin-bottom:0;"><label>Product</label>
                        <select name="productIds" class="form-control" onchange="setPrice(this)">
                            @foreach (var p in products) { <option value="@p.Id" data-price="@p.SellingPrice">@p.Name (₹@p.SellingPrice)</option> }
                        </select></div>
                    <div class="form-group" style="margin-bottom:0;"><label>Qty</label><input type="number" name="quantities" class="form-control" value="1" min="1" /></div>
                    <div class="form-group" style="margin-bottom:0;"><label>Unit Price</label><input type="number" name="unitPrices" class="form-control" step="0.01" /></div>
                    <div class="form-group" style="margin-bottom:0;"><label>Disc %</label><input type="number" name="discountPcts" class="form-control" value="0" step="0.01" /></div>
                </div>
            </div>
            <button type="button" class="btn btn-secondary btn-sm" onclick="addSaleItem()" style="margin-bottom:20px;">+ Add Item</button><br/>
            <button type="submit" class="btn btn-success">Create Sales Order</button>
            <a href="/Sales" class="btn btn-secondary" style="margin-left:8px;">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
<script>
function setPrice(sel) {
    const price = sel.options[sel.selectedIndex].dataset.price;
    const row = sel.closest('.form-row');
    row.querySelector('input[name="unitPrices"]').value = price;
}
document.querySelectorAll('select[name="productIds"]').forEach(s => setPrice(s));

function addSaleItem() {
    const div = document.getElementById('items');
    div.innerHTML += `<div class="form-row" style="margin-bottom:12px;">
        <div class="form-group" style="flex:2; margin-bottom:0;"><select name="productIds" class="form-control" onchange="setPrice(this)">@Html.Raw(string.Join("", products.Select(p => $"<option value='{p.Id}' data-price='{p.SellingPrice}'>{p.Name} (₹{p.SellingPrice})</option>")))</select></div>
        <div class="form-group" style="margin-bottom:0;"><input type="number" name="quantities" class="form-control" value="1" min="1" /></div>
        <div class="form-group" style="margin-bottom:0;"><input type="number" name="unitPrices" class="form-control" step="0.01" /></div>
        <div class="form-group" style="margin-bottom:0;"><input type="number" name="discountPcts" class="form-control" value="0" step="0.01" /></div>
    </div>`;
    div.querySelectorAll('select[name="productIds"]').forEach(s => setPrice(s));
}
</script>
}
