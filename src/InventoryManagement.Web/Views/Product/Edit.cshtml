@model Product
@{
    ViewData["Title"] = "Edit Product";
    var categories = (List<Category>)ViewBag.Categories;
    var units = (List<Unit>)ViewBag.Units;
}

<div class="card" style="max-width:800px;">
    <div class="card-header"><h3>Edit: @Model.Name</h3></div>
    <div class="card-body">
        @if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }
        <form method="post" asp-action="Edit" enctype="multipart/form-data">
            <input type="hidden" name="Id" value="@Model.Id" />
            <div class="form-row">
                <div class="form-group"><label>Product Name *</label><input type="text" name="Name" class="form-control" value="@Model.Name" required /></div>
                <div class="form-group"><label>SKU *</label><input type="text" name="SKU" class="form-control" value="@Model.SKU" required /></div>
            </div>
            <div class="form-group"><label>Description</label><textarea name="Description" class="form-control">@Model.Description</textarea></div>
            <div class="form-row">
                <div class="form-group">
                    <label>Category *</label>
                    <select name="CategoryId" class="form-control" required>
                        @foreach (var c in categories)
                        {
                            if (c.Id == Model.CategoryId) { <option value="@c.Id" selected>@c.Name</option> }
                            else { <option value="@c.Id">@c.Name</option> }
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Unit *</label>
                    <select name="UnitId" class="form-control" required>
                        @foreach (var u in units)
                        {
                            if (u.Id == Model.UnitId) { <option value="@u.Id" selected>@u.Name (@u.Abbreviation)</option> }
                            else { <option value="@u.Id">@u.Name (@u.Abbreviation)</option> }
                        }
                    </select>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Cost Price *</label><input type="number" name="CostPrice" class="form-control" value="@Model.CostPrice" step="0.01" required /></div>
                <div class="form-group"><label>Selling Price *</label><input type="number" name="SellingPrice" class="form-control" value="@Model.SellingPrice" step="0.01" required /></div>
                <div class="form-group"><label>Reorder Level</label><input type="number" name="ReorderLevel" class="form-control" value="@Model.ReorderLevel" /></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Barcode</label><input type="text" name="Barcode" class="form-control" value="@Model.Barcode" /></div>
                <div class="form-group"><label>Batch Number</label><input type="text" name="BatchNumber" class="form-control" value="@Model.BatchNumber" /></div>
                <div class="form-group"><label>Expiry Date</label><input type="date" name="ExpiryDate" class="form-control" value="@(Model.ExpiryDate?.ToString("yyyy-MM-dd"))" /></div>
            </div>
            <div class="form-group"><label>Product Image</label><input type="file" name="imageFile" class="form-control" accept="image/*" /></div>
            <div class="form-group">
                <div class="form-check">
                    <input type="checkbox" name="IsActive" value="true" id="isActive" @(Model.IsActive ? "checked" : "") />
                    <label for="isActive">Active</label>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a href="/Product" class="btn btn-secondary" style="margin-left:8px;">Cancel</a>
        </form>
    </div>
</div>
