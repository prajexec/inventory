@model User
@{
    ViewData["Title"] = "Edit User";
    var roles = (List<Role>)ViewBag.Roles;
    var userRoleIds = Model.UserRoles.Select(ur => ur.RoleId).ToList();
}

<div class="card" style="max-width:600px;">
    <div class="card-header"><h3>Edit User: @Model.FullName</h3></div>
    <div class="card-body">
        @if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }

        <form method="post" asp-action="EditUser">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="form-group">
                <label>Full Name</label>
                <input type="text" name="fullName" class="form-control" value="@Model.FullName" required />
            </div>
            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" class="form-control" value="@Model.Email" required />
            </div>
            <div class="form-group">
                <label>Roles</label>
                @foreach (var role in roles)
                {
                    <div class="form-check" style="margin-bottom:4px;">
                        <input type="checkbox" name="roleIds" value="@role.Id" id="role_@role.Id"
                               @(userRoleIds.Contains(role.Id) ? "checked" : "") />
                        <label for="role_@role.Id">@role.Name</label>
                    </div>
                }
            </div>
            <div class="form-group">
                <div class="form-check">
                    <input type="checkbox" name="isActive" value="true" id="isActive"
                           @(Model.IsActive ? "checked" : "") />
                    <label for="isActive">Active</label>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a href="/Account/Users" class="btn btn-secondary" style="margin-left:8px;">Cancel</a>
        </form>
    </div>
</div>
