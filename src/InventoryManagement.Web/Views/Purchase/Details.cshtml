@model PurchaseOrder
@{ ViewData["Title"] = $"PO: {Model.OrderNumber}"; }

<div style="display:flex; gap:24px; flex-wrap:wrap;">
    <div class="card" style="flex:1; min-width:500px;">
        <div class="card-header">
            <h3>@Model.OrderNumber</h3>
            <span class="badge @(Model.Status == OrderStatus.Pending ? "badge-warning" : Model.Status == OrderStatus.Approved ? "badge-info" : Model.Status == OrderStatus.Delivered ? "badge-success" : "badge-danger")" style="font-size:14px;">@Model.Status</span>
        </div>
        <div class="card-body">
            <div class="form-row" style="margin-bottom:20px;">
                <div><strong style="color:var(--text-muted); font-size:13px;">Supplier</strong><br/>@Model.Supplier.Name</div>
                <div><strong style="color:var(--text-muted); font-size:13px;">Warehouse</strong><br/>@Model.Warehouse.Name</div>
                <div><strong style="color:var(--text-muted); font-size:13px;">Created By</strong><br/>@Model.CreatedBy.FullName</div>
                <div><strong style="color:var(--text-muted); font-size:13px;">Order Date</strong><br/>@Model.OrderDate.ToString("MMM dd, yyyy")</div>
            </div>
            <div class="table-container"><table>
                <thead><tr><th>Product</th><th>Qty</th><th>Unit Price</th><th>Total</th><th>Received</th></tr></thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td style="font-weight:600;">@item.Product.Name</td>
                            <td>@item.Quantity</td>
                            <td>₹@item.UnitPrice.ToString("N2")</td>
                            <td style="font-weight:700;">₹@item.TotalPrice.ToString("N2")</td>
                            <td>@item.ReceivedQuantity</td>
                        </tr>
                    }
                </tbody>
                <tfoot><tr><td colspan="3" style="text-align:right; font-weight:700;">Total:</td><td style="font-weight:700; font-size:18px;">₹@Model.TotalAmount.ToString("N2")</td><td></td></tr></tfoot>
            </table></div>
        </div>
    </div>
    <div style="width:300px;">
        @if (Model.Status != OrderStatus.Delivered && Model.Status != OrderStatus.Cancelled)
        {
            <div class="card" style="margin-bottom:16px;">
                <div class="card-header"><h3>Update Status</h3></div>
                <div class="card-body">
                    @if (Model.Status == OrderStatus.Pending)
                    {
                        <form method="post" asp-action="UpdateStatus"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="status" value="1" /><button type="submit" class="btn btn-primary" style="width:100%;">Approve Order</button></form>
                    }
                    @if (Model.Status == OrderStatus.Approved)
                    {
                        <form method="post" asp-action="UpdateStatus"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="status" value="2" /><button type="submit" class="btn btn-success" style="width:100%;">Mark as Delivered</button></form>
                        <p style="font-size:12px; color:var(--text-muted); margin-top:8px;">This will automatically add stock to the warehouse.</p>
                    }
                </div>
            </div>
        }
        @if (Model.Invoice != null)
        {
            <div class="card">
                <div class="card-header"><h3>Invoice</h3></div>
                <div class="card-body">
                    <p><strong>Invoice #:</strong> @Model.Invoice.InvoiceNumber</p>
                    <p><strong>Amount:</strong> ₹@Model.Invoice.Amount.ToString("N2")</p>
                    <p><strong>Tax:</strong> ₹@Model.Invoice.TaxAmount.ToString("N2")</p>
                    <p><strong>Total:</strong> <span style="font-weight:700; font-size:18px;">₹@Model.Invoice.TotalAmount.ToString("N2")</span></p>
                    <p><strong>Status:</strong> <span class="badge badge-warning">@Model.Invoice.PaymentStatus</span></p>
                </div>
            </div>
        }
    </div>
</div>
